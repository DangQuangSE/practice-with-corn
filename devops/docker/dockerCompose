version: '3.8'

services:
  # ------------------------------------------------------
  # Cấu hình Service Database (PostgreSQL)
  # ------------------------------------------------------
  db:
    image: postgres:16-alpine
    container_name: todo-postgres-db
    environment:
      POSTGRES_DB: todo_db
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: secret_password
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - todo-network

  # ------------------------------------------------------
  # Cấu hình Service Ứng dụng Java (Spring Boot)
  # ------------------------------------------------------
  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: todo-spring-app
    ports:
      - "8080:8080"
    # Đảm bảo database phải khởi động trước khi ứng dụng Spring Boot chạy
    depends_on:
      - db
    # Ghi đè các biến môi trường của Spring Boot để kết nối tới container 'db' ở trên
    environment:
      - SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/todo_db
      - SPRING_DATASOURCE_USERNAME=admin
      - SPRING_DATASOURCE_PASSWORD=secret_password
    networks:
      - todo-network

# Định nghĩa các tài nguyên dùng chung (Volume và Network)
volumes:
  postgres_data: # Lưu trữ dữ liệu database lâu dài trên máy host

networks:
  todo-network:
    driver: bridge # Tạo một mạng bridge ảo nội bộ cho 2 container giao tiếp với nhau